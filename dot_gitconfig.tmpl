[user]
    name = {{ .name }}
    email = {{ .email }}

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    editor = vim
    excludesfile = ~/.gitignore_global

{{- if .gitProxy }}

[http]
    proxy = {{ .gitProxy }}

[https]
    proxy = {{ .gitProxy }}

{{- end }}